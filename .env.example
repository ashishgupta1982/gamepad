# GamePad — environment
#
# Copy to .env.local and fill in. .env.local is gitignored and holds live
# secrets; never commit it or paste its contents anywhere.

# --- Database -------------------------------------------------------------
MONGODB_URI=

# --- NextAuth -------------------------------------------------------------
# NEXTAUTH_SECRET must be a generated value, not a placeholder — a guessable
# secret means forgeable session tokens. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Auth providers (@aspiro/auth) ---------------------------------------
# Google. Names match the shared package — do not rename to GOOGLE_CLIENT_ID.
GOOGLE_ID=
GOOGLE_SECRET=

# Apple is OPTIONAL and self-activating: the package registers the provider only
# when all four of these are present, and stays dormant otherwise. Adding Apple
# is an env-var change, never a code change. Set NEXT_PUBLIC_APPLE_ENABLED=true
# alongside them so the client renders the button.
# APPLE_SERVICES_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# NEXT_PUBLIC_APPLE_ENABLED=true

# --- Transactional email (@aspiro/auth) -----------------------------------
# Used for email verification and password resets, via Resend's REST API.
#
# If RESEND_API_KEY is unset, every send becomes a no-op that logs the link to
# the server console instead — so the flow is still completable locally by
# pasting the URL into a browser, and nothing throws. That is convenient in dev
# and is exactly why "email isn't sending" in production is almost always a
# missing env var rather than a bug: it fails silently by design.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- AI -------------------------------------------------------------------
# Used by /api/claude and the Travel Bingo card generator.
ANTHROPIC_API_KEY=
